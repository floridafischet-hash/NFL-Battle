# ============================================================================
# NFL Bracket Battle – Konfiguration
#   cp .env.example .env
#   ./scripts/generate-secrets.sh      (empfohlen: ersetzt alle CHANGE_ME-Werte)
#   docker compose up -d
# Platzhalter (CHANGE_ME…) funktionieren für einen ersten Test: SECRET_KEY,
# Admin- und Demo-Passwort werden dann beim ersten Start zufällig erzeugt und
# im Log ausgegeben:  docker compose logs migrate
# Diese Datei enthält KEINE echten Secrets – .env niemals committen.
# ============================================================================

# --- Allgemein ---------------------------------------------------------------
APP_ENV=production
APP_TIMEZONE=Europe/Berlin
LOG_LEVEL=INFO
# Öffentliche Adresse (ohne / am Ende). Mit HTTPS: https://tippspiel.example.de
PUBLIC_URL=http://localhost:8080
# Port & Bind-Adresse von Nginx (ohne Traefik)
HTTP_PORT=8080
HTTP_BIND=0.0.0.0

# --- Datenbank ---------------------------------------------------------------
POSTGRES_DB=nfl
POSTGRES_USER=nfl
# Nur Buchstaben/Ziffern verwenden (wird in eine URL eingesetzt)
POSTGRES_PASSWORD=CHANGE_ME_postgres

# --- Login / Benutzer --------------------------------------------------------
# Signatur-Schlüssel für Login-Tokens (min. 32 Zeichen)
SECRET_KEY=CHANGE_ME_secret_key
# Gültigkeit eines Logins in Tagen
TOKEN_TTL_DAYS=30
# Erster Admin-Account (wird nur angelegt, wenn er noch nicht existiert)
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Admin
ADMIN_PASSWORD=CHANGE_ME_admin

# --- Demo-Daten --------------------------------------------------------------
# true = beim ersten Start Demo-Saisons und die Benutzer Florian, Dennis, Stefan,
# Marcel, Lisa, Kevin und Tobi anlegen (nur wenn noch keine Saison existiert)
SEED_DEMO_DATA=true
DEMO_USER_PASSWORD=CHANGE_ME_demo

# --- Uploads -----------------------------------------------------------------
MAX_UPLOAD_MB=5

# --- OpenClaw Agent ----------------------------------------------------------
# Agent-Token im Adminbereich unter „OpenClaw“ erzeugen (nicht hier eintragen).
# Erlaubte Ergebnis-Quellen (Domains, Subdomains inklusive)
AGENT_TRUSTED_DOMAINS=nfl.com,espn.com,cbssports.com,foxsports.com,apnews.com,reuters.com,pro-football-reference.com,sports.yahoo.com,nbcsports.com
# Anzahl unabhängiger vertrauenswürdiger Quellen, bevor automatisch gewertet wird
AGENT_MIN_CONFIRMATIONS=1
# Frühestens so viele Minuten nach Kickoff wird ein Ergebnis akzeptiert
AGENT_RESULT_MIN_MINUTES_AFTER_KICKOFF=60
# Optional: Webhook, den „Ergebnisprüfung starten“ bei OpenClaw auslöst
OPENCLAW_WEBHOOK_URL=
OPENCLAW_WEBHOOK_TOKEN=

# --- Erinnerungen ------------------------------------------------------------
# NFL Bot erinnert an fehlende Tipps so viele Stunden vor dem Tipp-Lock
REMINDER_HOURS_BEFORE_LOCK=24

# --- HTTPS (nur docker-compose.prod.yml) -------------------------------------
DOMAIN=tippspiel.example.de
ACME_EMAIL=admin@example.de
